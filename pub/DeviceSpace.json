{
  "AppSettings": {
    "Fusion": {
      "Name": "TuraSort",
      "DiagnosticPort": 9999,
      "ReactionList": [
        {
          "Name": "StandardSort",
          "Type": "StandardSort",
          "Enable": true,
          "Properties": {
            "Diverts": "1;2;3;4;5;15"
          },

          "Bonds": [
            {
              "Mode": 1,
              "Name": "Bond1-InductRequestToResponse",
              "Source": "CP1.DReqM.SNC302",
              "Handler": "HandleInductionRoundRobinSort",
              "Destination": "CP1.DRespM.SNC302"
            },
            { "Mode": 0,
              "Name": "Bond2-InductRequestToSQL",
              "Source": "CP1.DReqM.SNC302",
              "Handler": "HandleInductionSqlSort",
              "Destination": "MSSQL_Store.Query.SNC302"
            },
            {
              "Mode": 0,
              "Name": "Bond1-InductRequestToResponse",
              "Source": "MSSQL_Store.Destination.SNC302",
              "Handler": "HandleDestinastionResult",
              "Destination": "CP1.DRespM.SNC302"
            }
          ]
        }
      ],
      "ElementList": [
        {
          "Name": "CP1",
          "Manager": "PlcElementManager",
          "Enable": true,
          "Properties": {
            "ElementPort": "6999",
            "HeartbeatTimeoutMs": "0"
          }
        },
        {
          "Name": "MSSQL_Store",
          "Manager": "DatabaseElementManager",
          "Enable": false,
          "Properties": {
            "DatabaseType": "MsSql",
            "ConnectionString": "Server=.\\SQLEXPRESS;Database=FortnaFire;Integrated Security=True;TrustServerCertificate=True;",       
            "HeartbeatTimeout": 0
          }
        },
        {
          "Name": "Postgres_Store",
          "Manager": "DatabaseElementManager",
          "Enable": false,
          "Properties": {
            "DatabaseType": "PostgreSql",
            "ConnectionString": "Host=localhost;Database=FortnaFire;Username=postgres;Password=YourPassword123;",
            "HeartbeatTimeout": 0
          }
        },
        {
          "Name": "MySQL_Store",
          "Manager": "DatabaseElementManager",
          "Enable": false,
          "Properties": {
            "DatabaseType": "MySql",
            "ConnectionString": "Server=localhost;Database=FortnaFire;Uid=root;Pwd=YourPassword123;",
            "HeartbeatTimeout": 0
          }
        },
        {
          "Name": "HostCommServer",
          "Manager": "TcpServerElementManager",
          "Enable": false,
          "Properties": {
            "Port": 5000,
            "MaxClients": 10,
            "BodyDelimiter": "|",
            "FieldNames": "Field1,Field2,Field3"
          }
        }
      ]
    }
  }
}



