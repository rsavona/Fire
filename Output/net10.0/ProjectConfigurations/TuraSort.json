{
  "AppSettings": {
    "DeviceSpace": {
      "Name": "TuraSort",
      "DiagnosticPort": 9999,
      "WorkflowList": [
        {
          "Name": "StandardSort",
          "Type": "StandardSort",
          "Enable": true,
          "Properties": {
            "Diverts": "1;2;3;4;5;15"
          },
          "Routes": [
            {
              "Mode": 0,
              "Name": "Route1-InductRequestToResponse",
              "Source": "CP1.DReqM.SCN302",
              "Handler": "HandleInductionRoundRobinSort",
              "Destination": "CP1.DRespM.SCN302"
            },
            {
              "Mode": 1,
              "Name": "Route2-InductRequestToSQL",
              "Source": "CP1.DReqM.SCN302",
              "Handler": "HandleInductionSqlSort",
              "Destination": "MSSQL_Store.Query.SCN302"
            },
            {
              "Mode": 1,
              "Name": "Route3-SQLToPLC",
              "Source": "MSSQL_Store.QueryResult.SCN302",
              "Handler": "HandleDestinationResult",
              "Destination": "CP1.DRespM.SCN302"
            }
          ]
        }
      ],
      "DeviceList": [
        {
          "Name": "CP1",
          "Manager": "PlcDeviceManager",
          "Enable": true,
          "Properties": {
            "DevicePort": "6999",
            "HeartbeatTimeoutMs": "0"
          }
        },
        {
          "Name": "MSSQL_Store",
          "Manager": "DatabaseDeviceManager",
          "Enable": true,
          "Properties": {
            "DatabaseType": "MsSql",
            "ConnectionString": "Server=.\\SQLEXPRESS;Database=FortnaFire;Integrated Security=True;TrustServerCertificate=True;",
            "HeartbeatTimeout": 0
          }
        },
        {
          "Name": "Postgres_Store",
          "Manager": "DatabaseDeviceManager",
          "Enable": false,
          "Properties": {
            "DatabaseType": "PostgreSql",
            "ConnectionString": "Host=localhost;Database=FortnaFire;Username=postgres;Password=YourPassword123;",
            "HeartbeatTimeout": 0
          }
        },
        {
          "Name": "MySQL_Store",
          "Manager": "DatabaseDeviceManager",
          "Enable": false,
          "Properties": {
            "DatabaseType": "MySql",
            "ConnectionString": "Server=localhost;Database=FortnaFire;Uid=root;Pwd=YourPassword123;",
            "HeartbeatTimeout": 0
          }
        },
        {
          "Name": "HostCommServer",
          "Manager": "TcpServerDeviceManager",
          "Enable": true,
          "Properties": {
            "Port": 5000,
            "MaxClients": 10,
            "BodyDelimiter": "|",
            "FieldNames": "Field1,Field2,Field3"
          }
        }
      ]
    }
  }
}



