              }
            },
            {
              "Name": "TNA2",
              "Manager": "VirtualPlcManager",
              "Enable": true,
              "Properties": {
                "IPAddress": "127.0.0.1",
                "Port": 6999,
                "HeartbeatTimeoutMs": 0,
                "HeartbeatIntervalMs": 0,
                "DecisionPoints": "PNALINE-2:0;PNA2_151:300|PNA2_152:300;PNA2_Verify:100",
                "TotalTotes": 500,
                "InductionFreq": 300,
                "Printer1": "PNA2_151",
                "Printer2": "PNA2_152"
                }
            },
            {
              "Name": "PNA2_151",
              "Manager": "VirtualPrinterManager",
              "Enable": true,
              "Properties": {
                "Port": 9100
              }
            },
            {
              "Name": "PNA2_152",
              "Manager": "VirtualPrinterManager",
              "Enable": true,
              "Properties": {
                "Port": "9101"
              }
            },
            {
              "Name": "vI001",
              "Manager": "VirtualPrinterManager",
              "Enable": false,
              "Properties": {
                "Port": 9102
              }
            },
            {
              "Name": "vI002",
              "Manager": "VirtualPrinterManager",
              "Enable": false,
              "Properties": {
                "Port": 9103
              }
            },
            {
              "Name": "DIAG_SERVER",
              "Manager": "DiagnosticElementManager",
              "Enable": false,
              "Properties": {
                "Port": 9999
              }
            }
          ],
          "Reactions": [
            {
              "Name": "Fusion.Reaction.Simulation",
              "Type": "ReactionSimulation",
              "Enable": true,
              "IsSimulation": true,
              "TotalTotes": 100,
              "InductionIntervalMs": 1000,
              "Bonds": [
                {
                  "Mode": 1,
				  "Comment":"LabelReq to LabelData For Testing",
                  "Name": "Bond1-LabelRequest",
                  "Source": "TBROKER.LabelRequestFrcMessage.AC.PNA.LABELREQUEST",
                  "Destination": "TBROKER.LabelDataFrcMessage.AC.PNA.LABELDATA",
                  "Handler": "HandleLabelRequest"
