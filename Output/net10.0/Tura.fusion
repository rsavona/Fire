{
  "AppSettings": {
    "DeviceSpace": {
      "Name": "TuraSort",
      "DiagnosticPort": 9999,
      "Cores": [
        {
          "Name": "Tura Core",
          "Elements": [
            {
              "Name": "CP1",
              "Manager": "PlcDeviceManager",
              "Enable": true,
              "Properties": {
                "DevicePort": "6999",
                "DeviceTimeout": "1500"
              }
            },
            {
              "Name": "SQLServer",
              "Manager": "DatabaseDeviceManager",
              "Enable": true,
              "Properties": {
                "ConnectionString": "Server=RSAVONA-LT1;Database=FortnaFire;Trusted_Connection=True;Encrypt=False;TrustServerCertificate=True;"
              }
            },
            {
              "Name": "DIAG_SERVER",
              "Manager": "DiagnosticDeviceManager",
              "Enable": true,
              "Properties": {
                "Port": 9998
              }
            }
          ],
          "Forces": [
            {
              "Name": "StandardSort",
              "Type": "StandardSort",
              "Enable": true,
              "Properties": {
                "Diverts": "1;2;3;4;5;15"
              },
              "Bonds": [
                {
                  "Mode": 1,
                  "Name": "Route1-InductRequestToResponse",
                  "Source": "CP1.DReqM.SCN302",
                  "Handler": "HandleInductionSqlSort",
                  "Destination": "SQLServer.Query.SCN302"
                },
                {
                  "Mode": 1,
                  "Name": "Route2-SQLtoPLC",
                  "Source": "SQLServer.QueryResult.SCN302",
                  "Handler": "HandleDestinationResult",
                  "Destination": "CP1.DRespM.SCN302"
                }
              ]
            }
          ]
        }
      ]
    }
  }
}
