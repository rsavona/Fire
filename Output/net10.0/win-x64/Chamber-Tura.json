{
  "AppSettings": {
    "Fusion": {
      "Name": "TuraSort",
      "DiagnosticPort": 9999,
      "ReactionList": [
        {
          "Name": "StandardSort",
          "Type": "StandardSort",
          "Enable": true,
          "Properties": {
            "Diverts": "1;2;3;4;5;15"
          },
          "Bonds": [
            {
              "Mode": 1,
              "Name": "Bond1-InductRequestToResponse",
              "Source": "CP1.DReqM.SCN302",
              "Handler": "HandleInductionSqlSort",
              "Destination": "SQLServer.Query.SCN302"
            },
            {
              "Mode": 1,
              "Name": "Bond2-SQLtoPLC",
              "Source": "SQLServer.QueryResult.SCN302",
              "Handler": "HandleDestinationResult",
              "Destination": "CP1.DRespM.SCN302"
            }
          ]
        }
      ],
      "ElementList": [
        {
          "Name": "CP1",
          "Manager": "PlcElementManager",
          "Enable": true,
          "Properties": {
            "ElementPort": "6999",
            "ElementTimeout": "1500"
          }
        },
        {
          "Name": "SQLServer",
          "Manager": "DatabaseElementManager",
          "Enable": true,
          "Properties": {
            "ConnectionString": "Server=RSAVONA-LT1;Database=FortnaFire;Trusted_Connection=True;Encrypt=False;TrustServerCertificate=True;"
          }
        },
        {
          "Name": "DIAG_SERVER",
          "Manager": "DiagnosticElementManager",
          "Enable": true,
          "Properties": {
            "Port": 9998
          }
        }
      ]
    }
  }
}



