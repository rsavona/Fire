{
  "AppSettings": {
    "DeviceSpace": {
      "Name": "TuraHostSystem",
      "ColorConsole": true,
      "DeviceList": [
        {
          "Name": "TURA_HOST",
          "Manager": "TcpMessageServerDeviceManager",
          "Enable": true,
          "Properties": {
            "Port": "6601",
            "MaxClients": "5",
            "Delimiter": "\\r\\n",
            "PayloadFormat": "FIXED",
            "FieldDefinitions": "MessageType:0:4,Barcode:4:18,Data:23:3"
          }
        },
        {
          "Name": "TURA_DB",
          "Manager": "DatabaseDeviceManager",
          "Enable": true,
          "Properties": {
            "ConnectionString": "Server=RSAVONA-LT1;Database=FortnaFire;Trusted_Connection=True;Encrypt=False;TrustServerCertificate=True;"
          }
        },
        {
          "Name": "DIAG_SERVER",
          "Manager": "DiagnosticDeviceManager",
          "Enable": true,
          "Properties": {
            "Port": 9999
          }
        }
      ],
      "WorkflowList": [
        {
          "Name": "TuraHostWorkflow",
          "Type": "TuraHostWorkflow",
          "Enable": true,
          "Routes": [
            {
              "Mode": 1,
              "Name": "TuraEchoRoute",
              "Source": "TURA_HOST.Inbound",
              "Handler": "HandleTuraMessages",
              "Destination": "TURA_HOST.Outbound.Echo"
            },
            {
              "Mode": 1,
              "Name": "TuraDbLogRoute",
              "Source": "TURA_HOST.Inbound",
              "Handler": "HandleDbLogging",
              "Destination": "TURA_DB.Log"
            }
          ]
        }
      ]
    }
  }
}



