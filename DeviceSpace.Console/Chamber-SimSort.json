          "Properties": {
            "ConnectionString": "tcp://127.0.0.1:61616?useKeepAlive=true",
            "DoubleQueue": true
          }
        },
        {
          "Name": "CP1",
          "Manager": "VirtualPlcManager",
          "Enable": true,
          "Properties": {
            "IPAddress": "127.0.0.1",
            "Port": 6999,
            "HeartbeatTimeoutMs": 0,
            "HeartbeatIntervalMs": 0,
            "DecisionPoints": [ "SNC302:0",
                                "SNC301:0",
                                "SNC303:0"],
            "TotalTotes": 1000,
            "InductionFreq": 50
          }
        },
        {
          "Name": "PNA2 151",
          "Manager": "VirtualPrinterManager",
          "Enable": true,
          "Properties": {
            "Port": 9100
          }
        },
        {
          "Name": "PNA2 152",
          "Manager": "VirtualPrinterManager",
          "Enable": true,
          "Properties": {
            "Port": "9101"
          }
        },
        {
          "Name": "vI001",
          "Manager": "VirtualPrinterManager",
          "Enable": false,
          "Properties": {
            "Port": 9102
          }
        },
        {
          "Name": "vI002",
          "Manager": "VirtualPrinterManager",
          "Enable": false,
          "Properties": {
            "Port": 9103
          }
        },
        {
          "Name": "DIAG_SERVER",
          "Manager": "DiagnosticDeviceManager",
          "Enable": true,
          "Properties": {
            "Port": 9999
          }
        }
      ],
      "WorkflowList": [
        {
          "Name": "Workflow.Simulation",
          "Type": "WorkflowSimulation",
          "Enable": true,
          "IsSimulation": true,
          "TotalTotes": 100,
          "InductionIntervalMs": 1000,
          "Routes": [
            {
              "Mode": 1,
              "Name": "Route1-LabelRequest",
              "Source": "TBROKER.LabelRequestFrcMessage.AC.PNA.LABELREQUEST",
              "Destination": "TBROKER.LabelDataFrcMessage.AC.PNA.LABELDATA",
              "Handler": "HandleLabelRequest"
            }
          ]
        }
      ]
    }
  }
}
      



