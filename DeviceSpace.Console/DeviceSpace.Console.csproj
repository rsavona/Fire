<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>DeviceSpaceConsole</RootNamespace>
        <LangVersion>14</LangVersion>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
      <OutputPath>..\Output\</OutputPath>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
      <OutputPath>..\Output\</OutputPath>
    </PropertyGroup>

      <ItemGroup>
      <ProjectReference Include="..\Fusion.Element.ActiveMQ\Fusion.Element.ActiveMQ.csproj" />
      <ProjectReference Include="..\Device.Api.Suite\Device.Api.Suite.csproj" />
      <ProjectReference Include="..\Device.Database.Suite\Device.Database.Suite.csproj" />
      <ProjectReference Include="..\Device.HostComm\Device.HostComm.csproj" />
   
      <ProjectReference Include="..\Device.Plc.Suite\Device.Plc.Suite.csproj" />
      <ProjectReference Include="..\Device.Printer.Suite\Device.Printer.Suite.csproj" />
      <ProjectReference Include="..\Device.Support.CLI\Device.Support.CLI.csproj" />
      <ProjectReference Include="..\Tools\TuraHostTester\TuraHostTester.csproj" />
      <ProjectReference Include="..\Fusion.Reactions.PandA\Fusion.Reactions.PandA.csproj" />
      <ProjectReference Include="..\Workflow.Simulation\Workflow.Simulation.csproj" />
      <ProjectReference Include="..\Workflow.Sort.Standard\Workflow.Sort.Standard.csproj" />
          <ProjectReference Include="..\Fusion.Core\Fusion.Core.csproj" />
          
          <ProjectReference Include="..\Workflow.Sort.Standard\Workflow.Sort.Standard.csproj" />
          
          <ProjectReference Include="..\Workflow.Tura.HostComm\Workflow.Tura.HostComm.csproj" />
          
          <ProjectReference Include="..\Device.Enterprise.Suite\Device.Enterprise.Suite.csproj" />
  
     </ItemGroup>
    
    <ItemGroup>
      <None Update="appsettings.json">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Update="*.fusion">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Update="Project Config\SimSort.fusion">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Update="Project Config\Simulaton.fusion">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
      <None Update="Project Config\TuraHost.fusion">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Update="Project Config\Tura.fusion">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Update="Project Config\TargetDekalb1.fusion">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Update="Project Config\TargetDekalb.fusion">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.1" />
      <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.5" />
      <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.7" />
      <PackageReference Include="Serilog" Version="4.3.1" />
      <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
      <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
      <PackageReference Include="Serilog.Enrichers.CorrelationId" Version="3.0.1" />
      <PackageReference Include="Serilog.Enrichers.Dynamic" Version="1.0.9" />
      <PackageReference Include="Serilog.Enrichers.Process" Version="3.0.0" />
      <PackageReference Include="Serilog.Enrichers.Thread" Version="4.0.0" />
      <PackageReference Include="Serilog.Expressions" Version="5.0.0" />
      <PackageReference Include="Serilog.Sinks.Map" Version="2.0.0" />
      <PackageReference Include="Stateless" Version="5.20.1" />
    </ItemGroup>
    <Target Name="BundleAiBuilder" AfterTargets="Build">
        <Message Text="Bundling Tokamak.AI tool..." Importance="high" />
        <Exec Command="dotnet publish ../Tokamak.AI/Tokamak.AI.csproj -c $(Configuration) -o $(ProjectDir)../Output/net10.0/tools/ai --no-self-contained" />
    </Target>

    <Target Name="CopyConfigAfterBuild" AfterTargets="Build">
        <Message Text="Copying appsettings.json to Output folder..." Importance="high" />
        <Copy SourceFiles="$(ProjectDir)appsettings.json" DestinationFolder="$(ProjectDir)../Output/net10.0/" />
    </Target>

</Project>
