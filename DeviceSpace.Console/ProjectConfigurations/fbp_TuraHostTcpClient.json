{
  "AppSettings": {
    "Fusion": {
      "Name": "TuraHostTcpClientScenario",
      "ColorConsole": true,
      "ElementList": [
        {
          "Name": "TURA_HOST",
          "Manager": "TcpMessageServerElementManager",
          "Enable": true,
          "Properties": {
            "Port": "6601",
            "MaxClients": "5",
            "Delimiter": "\\r\\n",
            "PayloadFormat": "FIXED",
            "FieldDefinitions": "MessageType:0:4,Barcode:4:18,Data:23:3"
          }
        },
      {
          "Name": "DIAG_SERVER",
          "Manager": "DiagnosticElementManager",
          "Enable": true,
          "Properties": {
            "Port": 9999
          }
        }
      ],
      "ReactionList": [
        {
          "Name": "TuraHostReaction",
          "Type": "HostReaction",
          "Enable": true,
          "Bonds": [
            {
              "Mode": 1,
              "Name": "TuraEchoBond",
              "Source": "TURA_HOST.Inbound",
              "Handler": "HandleTuraMessages",
              "Destination": "TURA_HOST.Outbound.Echo"
            }
          ]
        }
      ]
    }
  }
}
