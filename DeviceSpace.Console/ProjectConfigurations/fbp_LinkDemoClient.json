{
  "AppSettings": {
    "Fusion": {
      "Name": "LinkDemoClient",
      "ColorConsole": true,
      "ElementList": [
        {
          "Name": "LINK_TO_SITE_A",
          "Manager": "LinkClientElementManager",
          "Enable": true,
          "Properties": {
            "IPAddress": "127.0.0.1",
            "Port": "7500",
            "Origin": "SITE_B",
            "RemoteTopics": "HOST_A.Inbound;HOST_A.Outbound.*",
            "PublishTopics": "LOCAL_SORTER.#",
            "HeartbeatIntervalMs": "5000"
          }
        },
        {
          "Name": "DIAG_SERVER",
          "Manager": "DiagnosticElementManager",
          "Enable": true,
          "Properties": {
            "Port": 9998
          }
        }
      ],
      "ReactionList": []
    }
  }
}
