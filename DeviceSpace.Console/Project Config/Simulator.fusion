{
  "AppSettings": {
    "DeviceSpace": {
      "Name": "Simulation",
      "ColorConsole": true,
      "Cores": [
        {
          "Name": "Simulation Core",
          "Elements": [
            {
              "Name": "TBROKER",
              "Manager": "ActiveMQManager",
              "Enable": true,
              "Properties": {
                "ConnectionString": "tcp://127.0.0.1:61616?useKeepAlive=true",
                "DoubleQueue": true
              }
            },
            {
              "Name": "TNA2",
              "Manager": "VirtualPlcManager",
              "Enable": true,
              "Properties": {
                "IPAddress": "127.0.0.1",
                "Port": 6999,
                "HeartbeatTimeoutMs": 0,
                "HeartbeatIntervalMs": 0,
                "DecisionPoints": "PNALINE-2:0;PNA2_151:1000|PNA2_152:2000;PNA2_Verify:3000",
                "TotalTotes": 1,
                "InductionFreq": 10000
              }
            },
            {
              "Name": "PNA2_151",
              "Manager": "VirtualPrinterManager",
              "Enable": true,
              "Properties": {
                "Port": 9100
              }
            },
            {
              "Name": "PNA2_152",
              "Manager": "VirtualPrinterManager",
              "Enable": true,
              "Properties": {
                "Port": "9101"
              }
            },
            {
              "Name": "vI001",
              "Manager": "VirtualPrinterManager",
              "Enable": false,
              "Properties": {
                "Port": 9102
              }
            },
            {
              "Name": "vI002",
              "Manager": "VirtualPrinterManager",
              "Enable": false,
              "Properties": {
                "Port": 9103
              }
            },
            {
              "Name": "DIAG_SERVER",
              "Manager": "DiagnosticDeviceManager",
              "Enable": false,
              "Properties": {
                "Port": 9999
              }
            }
          ],
          "Forces": [
            {
              "Name": "Workflow.Simulation",
              "Type": "WorkflowSimulation",
              "Enable": true,
              "IsSimulation": true,
              "TotalTotes": 100,
              "InductionIntervalMs": 1000,
              "Bonds": [
                {
                  "Mode": 1,
                  "Name": "Route1-LabelRequest",
                  "Source": "TBROKER.LabelVerifyFrcMessage.AC.PNAX.LABELVERIFY",
                  "Destination": "TBROKER.LabelVerifyFrcMessage.AC.PNAX.LABELVERIFY",
                  "Handler": "HandleLabelVerify"
                }
              ]
            }
          ]
        }
      ]
    }
  }
}
