{
  "name": "print-and-apply-real-world",
  "description": "Print and Apply real-world timing test suite. Stage 1 validates one-box-at-a-time timing. Later stages add overlapping happy-path boxes, no-read scans, side-by-side reads, printer availability cycle scenarios, and a clean 100-tote soak phase.",
  "physicalModel": {
    "lineLengthFeet": 12,
    "boxLengthFeet": 2,
    "conveyorSpeedFeetPerSecond": 2,
    "timingBasis": "lead-edge",
    "notes": [
      "12 feet at 2 feet per second gives 6 seconds from induct to verification.",
      "A 2 foot box has a 1 second body length at this conveyor speed.",
      "The 6 second spacing validates the simple one-box-at-a-time baseline before adding overlapping boxes."
    ]
  },
  "virtualPlcProperties": {
    "DecisionPoints": "PNALINE-2:0;PNA2_151:3000|PNA2_152:3000;PNA2_Verify:3000",
    "TotalTotes": 225,
    "InductionFreq": 0,
    "Printer1": "PNA2_151",
    "Printer2": "PNA2_152",
    "BarcodeList": [
      "PNA-STG1-0001",
      "PNA-STG1-0002",
      "PNA-STG1-0003",
      "PNA-STG1-0004",
      "PNA-STG1-0005"
    ]
  },
  "testRunnerNotes": [
    "The current Virtual PLC lifecycle is globally ordered. These cases describe the target real-world scripted behavior where multiple boxes can be between induct and verification at the same time.",
    "A scripted runner should induct new boxes based on each stage's inductionSpacingMs instead of waiting for the previous box lifecycle to finish.",
    "Stages with random fault placement use fixed positions here so log validation is repeatable."
  ],
