@using System.Text.Json
@using Fusion.Common.Blueprints
@using Microsoft.AspNetCore.Components.Forms
@using FusionLab.Services
@inject IJSRuntime JSRuntime
@inject CompoundService CompoundService
@inject AiBlueprintService AiService

<div class="d-flex flex-row flex-grow-1 w-100" style="overflow: hidden; height: calc(100vh - 48px);">

    <!-- LEFT SIDEBAR: TOOLKIT -->
    <ToolkitSidebar OnItemDragStart="OnDragStart" />

    <!-- MAIN CANVAS AREA -->
    <div class="flex-grow-1 p-4 h-100 d-flex flex-column" style="position: relative;">
        <div class="d-flex justify-content-between align-items-center designer-header">
            <h5 class="designer-title m-0"><i class="bi bi-layers-half text-warning"></i> PROJECT BLUEPRINT BUILDER</h5>
            <div class="d-flex gap-2">
                <button class="btn-fusion btn-fusion-outline" style="border-color: var(--fusion-accent); color: var(--fusion-accent);" @onclick="() => _showAiModal = true">
                    <i class="bi bi-robot"></i> AI BUILDER
                </button>
                <button class="btn-fusion btn-fusion-outline" @onclick="CollapseAll">COLLAPSE ALL</button>
                <button class="btn-fusion btn-fusion-outline" style="border-color: #ef4444; color: #ef4444;" @onclick="ClearCanvas">CLEAR CANVAS</button>

                <div class="ms-2 border-start border-secondary ps-3 d-flex gap-2">
                    <button class="btn-fusion btn-fusion-outline" @onclick="() => _isJsonVisible = !_isJsonVisible">
                        <i class="bi @(_isJsonVisible ? "bi-eye-slash" : "bi-code-slash")"></i>
                        @(_isJsonVisible ? "HIDE JSON" : "SHOW JSON")
                    </button>
                </div>
            </div>
        </div>

        <div class="canvas-container p-4 flex-grow-1 overflow-auto" @ondragover:preventDefault @ondrop="OnDrop">
            @foreach (var core in _systemBlueprintTemplate.Compounds)
            {
                <div class="core-section mb-4 p-3 border rounded shadow-sm">
                    <div class="d-flex justify-content-between align-items-center mb-3 border-bottom border-secondary pb-2">
                        <div class="d-flex align-items-center gap-2">
                            <h6 class="core-title m-0 fw-bold">PROJECT:</h6>
                            <input class="prop-input-fusion text-start fw-bold" style="border-bottom: 1px solid var(--fusion-border); font-size: 1rem; width: 250px; background: transparent; color: white;" @bind="core.Name" placeholder="Project Name" />
                        </div>
                        <div class="text-info" style="font-size: 0.9rem;">
                            <i class="bi bi-clock-history"></i> <strong>Est. Commission Time:</strong> @(_estimatedCommissionTime)
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <label class="section-label">ELEMENTS</label>
                            @foreach (var element in core.Elements)
                            {
                                <div class="fusion-item-card border rounded p-1 mb-2 shadow-sm" style="border: 1px solid #ef4444 !important; border-left: 4px solid #ef4444 !important; max-width: 95%;">
                                    <div class="card-header-fusion d-flex align-items-center justify-content-between p-2" style="cursor: pointer; background: rgba(255,255,255,0.05);" @onclick="() => ToggleCollapse(element)">
                                        <div class="d-flex align-items-center gap-2 flex-grow-1">
                                            <i class="bi @(IsCollapsed(element) ? "bi-chevron-right" : "bi-chevron-down") text-muted"></i>
                                            <i class="bi @GetIconForManager(element.Manager)"></i>
                                            <input class="form-control-fusion flex-grow-1 m-0 p-1 fw-bold" style="max-width: 250px; background: transparent; border: 1px solid var(--fusion-border); color: white;" @bind="element.Name" @onclick:stopPropagation placeholder="Element Name" />
                                            <span class="text-muted fw-normal ms-2" style="font-size: 0.75rem;">(@element.Manager)</span>
                                        </div>
                                        <button class="btn text-muted p-0 hover-danger ms-2" @onclick:stopPropagation @onclick="() => RemoveElement(core, element)"><i class="bi bi-x-lg"></i></button>
                                    </div>
                                    @if (!IsCollapsed(element))
                                    {
                                        <div class="card-body-fusion p-2">
                                            @if(element.Properties != null)
                                            {
                                                <div class="mt-2">
                                                    @foreach(var key in element.Properties.Keys.ToList())
                                                    {
                                                        <div class="prop-row-fusion">
                                                            <span class="prop-label-fusion">@key</span>
                                                            <input class="prop-input-fusion" value="@element.Properties[key]" @onchange="@((ChangeEventArgs e) => UpdateProperty(element, key, e.Value))" />
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                        <div class="col-md-6">
                            <label class="section-label">REACTIONS</label>
                            @foreach (var reaction in core.Reactions)
                            {
                                <div class="fusion-item-card border rounded p-1 mb-2 shadow-sm" style="border: 1px solid var(--fusion-accent) !important; border-left: 4px solid var(--fusion-accent) !important; max-width: 95%;">
                                    <div class="card-header-fusion d-flex align-items-center justify-content-between p-2" style="cursor: pointer; background: rgba(255,255,255,0.05);" @onclick="() => ToggleCollapse(reaction)">
                                        <div class="d-flex align-items-center gap-2 flex-grow-1">
                                            <i class="bi @(IsCollapsed(reaction) ? "bi-chevron-right" : "bi-chevron-down") text-muted"></i>
                                            <i class="bi bi-diagram-3-fill text-warning"></i>
                                            <input class="form-control-fusion flex-grow-1 m-0 p-1 fw-bold" style="max-width: 250px; background: transparent; border: 1px solid var(--fusion-border); color: white;" @bind="reaction.Name" @onclick:stopPropagation placeholder="Reaction Name" />
                                        </div>
                                        <button class="btn text-muted p-0 hover-danger ms-2" @onclick:stopPropagation @onclick="() => RemoveReaction(core, reaction)"><i class="bi bi-x-lg"></i></button>
                                    </div>
                                    @if (!IsCollapsed(reaction))
                                    {
                                        <div class="card-body-fusion p-2">
                                            <div class="d-flex justify-content-between align-items-center mb-2 mt-2 border-bottom border-secondary pb-1">
                                                <small class="section-label mb-0" style="font-size: 0.6rem;">BONDS</small>
                                                <button class="btn-fusion btn-fusion-outline btn-xs" @onclick="() => AddBond(reaction)">+ ADD BOND</button>
                                            </div>
                                            @foreach(var bond in reaction.Bonds)
                                            {
                                                <div class="p-2 mb-2" style="background: rgba(255,255,255,0.02); border: 1px solid var(--fusion-border); border-radius: var(--fusion-radius);">
                                                    <div class="input-group input-group-sm mb-1">
                                                        <span class="input-group-text bg-transparent border-0 text-muted" style="width: 35px; font-size: 0.65rem;">IN</span>
                                                        <input type="text" class="form-control-fusion flex-grow-1" @bind="bond.Source">
                                                        <button class="btn btn-fusion btn-fusion-outline p-1" @onclick="() => OpenBondBuilder(bond, true)"><i class="bi bi-tools"></i></button>
                                                    </div>
                                                    <div class="input-group input-group-sm mb-1">
                                                        <span class="input-group-text bg-transparent border-0 text-muted" style="width: 35px; font-size: 0.65rem;">OUT</span>
                                                        <input type="text" class="form-control-fusion flex-grow-1" @bind="bond.Destination">
                                                        <button class="btn btn-fusion btn-fusion-outline p-1" @onclick="() => OpenBondBuilder(bond, false)"><i class="bi bi-tools"></i></button>
                                                    </div>
                                                    <div class="input-group input-group-sm">
                                                        <span class="input-group-text bg-transparent border-0 text-muted" style="width: 35px;"><i class="bi bi-shuffle"></i></span>
                                                        <input type="text" class="form-control-fusion flex-grow-1" @bind="bond.Handler">
                                                        <button class="btn-fusion btn-fusion-primary p-1" @onclick="() => OpenHandlerBuilder(bond)"><i class="bi bi-magic"></i></button>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- RIGHT SIDEBAR: JSON (Toggleable) -->
    @if (_isJsonVisible)
    {
        <div class="right-sidebar">
            <div class="sidebar-section-header">
                <span>LIVE BLUEPRINT JSON</span>
            </div>
            <textarea @ref="_jsonTextarea" readonly class="json-textarea-fusion">@GetJson()</textarea>
            
            <div class="p-2 d-flex gap-2 bg-dark-subtle border-top border-secondary">
                <button class="btn-fusion btn-fusion-primary flex-grow-1" @onclick="SaveJson">
                    <i class="bi bi-download"></i> SAVE
                </button>
                <label class="btn-fusion btn-fusion-outline flex-grow-1 m-0 text-center pointer">
                    <i class="bi bi-upload"></i> LOAD
                    <InputFile OnChange="LoadJson" class="d-none" />
                </label>
            </div>
        </div>
    }

</div>

@if (_showBondModal)
{
    <BondBuilderModal 
        Elements="@_systemBlueprintTemplate.Compounds.SelectMany(c => c.Elements).Select(d => d.Name)"
        InitialElement="@_systemBlueprintTemplate.Compounds.SelectMany(c => c.Elements).FirstOrDefault()?.Name"
        OnApply="ApplyBondTopic"
        OnClose="() => _showBondModal = false" />
}

@if (_showHandlerModal)
{
    <HandlerBuilderModal 
        MessageSchemas="_messageSchemas"
        OnApply="ApplyHandler"
        OnClose="() => _showHandlerModal = false" />
}

@if (_showAiModal)
{
    <AiBuilderModal 
        OnBlueprintGenerated="OnAiBlueprintGenerated"
        OnClose="() => _showAiModal = false" />
}

@code {
    private SystemBlueprintTemplate _systemBlueprintTemplate = new SystemBlueprintTemplate { Compounds = new List<CompoundBlueprint> { new CompoundBlueprint { Name = "Default" } } };
    private string _draggedType;
    private bool _isJsonVisible = false;
    private bool _showAiModal = false;
    private string _estimatedCommissionTime = "";
    private HashSet<object> _collapsedItems = new HashSet<object>();
    private ElementReference _jsonTextarea;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_isJsonVisible)
        {
            await JSRuntime.InvokeVoidAsync("autoResizeTextarea", _jsonTextarea);
        }
    }

    private Dictionary<string, List<string>> _messageSchemas = new() {
        { "DReqM", new() { "Gin", "Sku", "Qty", "StationId" } },
        { "LabelToPrint", new() { "PrinterName", "RawData", "JobId" } },
        { "StatusUpdate", new() { "ElementId", "Code", "Message" } }
    };

    private bool _showBondModal, _showHandlerModal, _isEditingSource;
    private BondBlueprint _editingBond;

    public string GetJson() => JsonSerializer.Serialize(new { 
        AppSettings = new { 
            Fusion = _systemBlueprintTemplate
        } 
    }, new JsonSerializerOptions { WriteIndented = true });

    private async Task SaveJson()
    {
        var json = GetJson();
        await JSRuntime.InvokeVoidAsync("downloadFile", $"{_systemBlueprintTemplate.CustomerName}_Blueprint.json", json);
    }

    private void ClearCanvas()
    {
        _systemBlueprintTemplate.Compounds.Clear();
        _systemBlueprintTemplate.Compounds.Add(new CompoundBlueprint { Name = "Default" });
    }

    public async Task LoadJson(InputFileChangeEventArgs e)
    {
        Console.WriteLine($"Attempting to load file: {e.File.Name}");
        try
        {
            using var reader = new StreamReader(e.File.OpenReadStream());
            var content = await reader.ReadToEndAsync();
            var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            
            var root = JsonDocument.Parse(content);
            if (!root.RootElement.TryGetProperty("AppSettings", out var appSettings) || 
                !appSettings.TryGetProperty("Fusion", out var fusion))
            {
                Console.WriteLine("Error: JSON structure missing AppSettings.Fusion root.");
                return;
            }

            var loadedTemplate = JsonSerializer.Deserialize<SystemBlueprintTemplate>(fusion.GetRawText(), options);
            
            if (loadedTemplate != null)
            {
                _systemBlueprintTemplate.CustomerName = loadedTemplate.CustomerName;
                _systemBlueprintTemplate.Compounds = loadedTemplate.Compounds ?? new List<CompoundBlueprint>();
                
                if (!_systemBlueprintTemplate.Compounds.Any())
                    _systemBlueprintTemplate.Compounds.Add(new CompoundBlueprint { Name = "Default" });

                Console.WriteLine($"Successfully loaded blueprint for: {_systemBlueprintTemplate.CustomerName}");
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading JSON: {ex.Message}");
        }
    }

    private void OnDragStart(string type) => _draggedType = type;

    private void OnDrop() => AddItemToCanvas(_draggedType);

    private void AddItemToCanvas(string type)
    {
        if (string.IsNullOrEmpty(type)) return;
        
        if (!_systemBlueprintTemplate.Compounds.Any())
            _systemBlueprintTemplate.Compounds.Add(new CompoundBlueprint { Name = "Default" });

        var targetCore = _systemBlueprintTemplate.Compounds[0];

        if (type.StartsWith("Compound:"))
        {
            var compoundName = type.Substring(9);
            var compound = CompoundService.GetDiscoveredCompounds().FirstOrDefault(c => c.Name == compoundName);
            if (compound != null)
            {
                // Deep copy elements and reactions into the current core
                foreach (var e in compound.Elements)
                {
                    var newElement = new ElementBlueprint { 
                        Name = $"{e.Name}_{targetCore.Elements.Count + 1}", 
                        Manager = e.Manager, 
                        Enable = true, 
                        Properties = new Dictionary<string, object>(e.Properties) 
                    };
                    targetCore.Elements.Add(newElement);
                }
                foreach (var r in compound.Reactions)
                {
                    var newReaction = new ReactionBlueprint { 
                        Name = $"{r.Name}_{targetCore.Reactions.Count + 1}", 
                        Type = r.Type, 
                        Enable = true,
                        Bonds = r.Bonds.Select(b => new BondBlueprint { 
                            Name = b.Name, 
                            Source = b.Source, 
                            Destination = b.Destination, 
                            Handler = b.Handler,
                            Mode = b.Mode
                        }).ToList()
                    };
                    targetCore.Reactions.Add(newReaction);
                }
            }
        }
        else if (type == "Reaction") {
            targetCore.Reactions.Add(new ReactionBlueprint { Name = $"Reaction_{targetCore.Reactions.Count + 1}", Enable = true });
        } else {
            var newElement = new ElementBlueprint { 
                Name = type.Replace("Manager", "").ToUpper() + "_" + (targetCore.Elements.Count + 1), 
                Manager = type, 
                Enable = true, 
                Properties = new() 
            };
            
            // Add basic defaults for known types
            if (type.Contains("Plc")) {
                newElement.Properties["ElementPort"] = 6999;
                newElement.Properties["IPAddress"] = "127.0.0.1";
            } else if (type.Contains("ActiveMq")) {
                newElement.Properties["ConnectionString"] = "tcp://localhost:61616";
            } else if (type.Contains("Printer")) {
                newElement.Properties["IPAddress"] = "127.0.0.1";
                newElement.Properties["Port"] = 9100;
            }
            
            targetCore.Elements.Add(newElement);
        }
        StateHasChanged();
    }

    private string GetIconForManager(string m) => m switch {
        string s when s.Contains("Plc") => "bi-hdd-rack-fill text-danger",
        string s when s.Contains("ActiveMq") => "bi-envelope-paper-fill text-info",
        string s when s.Contains("Printer") => "bi-printer-fill text-warning",
        string s when s.Contains("Database") => "bi-database-fill text-primary",
        _ => "bi-cpu-fill text-white-50"
    };

    private void ToggleCollapse(object i) { if(_collapsedItems.Contains(i)) _collapsedItems.Remove(i); else _collapsedItems.Add(i); }
    private bool IsCollapsed(object i) => _collapsedItems.Contains(i);
    
    private void CollapseAll()
    {
        foreach(var core in _systemBlueprintTemplate.Compounds) {
            foreach(var element in core.Elements) _collapsedItems.Add(element);
            foreach(var reaction in core.Reactions) _collapsedItems.Add(reaction);
        }
    }

    private void UpdateProperty(ElementBlueprint d, string k, object v) { if(d.Properties.ContainsKey(k)) d.Properties[k] = v; }
    private void RemoveElement(CompoundBlueprint core, ElementBlueprint element) => core.Elements.Remove(element);
    
    private void AddBond(ReactionBlueprint reaction) => reaction.Bonds.Add(new BondBlueprint { Name = "New Bond", Source = "In", Destination = "Out", Handler = "DefaultHandler" });
    private void RemoveReaction(CompoundBlueprint core, ReactionBlueprint reaction) => core.Reactions.Remove(reaction);

    private void OpenBondBuilder(BondBlueprint bond, bool isSrc) 
    { 
        _editingBond = bond; 
        _isEditingSource = isSrc; 
        _showBondModal = true; 
    }

    private async Task ApplyBondTopic(string topicString) 
    { 
        if (_isEditingSource) _editingBond.Source = topicString; 
        else _editingBond.Destination = topicString; 
        _showBondModal = false; 
        await Task.CompletedTask;
    }

    private void OpenHandlerBuilder(BondBlueprint reaction) 
    { 
        _editingBond = reaction; 
        _showHandlerModal = true; 
    }

    private async Task ApplyHandler(string handlerString) 
    { 
        _editingBond.Handler = handlerString; 
        _showHandlerModal = false; 
        await Task.CompletedTask;
    }

    private async Task OnAiBlueprintGenerated(string json)
    {
        try
        {
            var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            var root = JsonDocument.Parse(json);
            var fusion = root.RootElement.GetProperty("AppSettings").GetProperty("Fusion");
            
            _systemBlueprintTemplate.CustomerName = fusion.GetProperty("Name").GetString();
            _systemBlueprintTemplate.Compounds.Clear();
            
            if (fusion.TryGetProperty("Cores", out var coresElement))
            {
                foreach (var coreElement in coresElement.EnumerateArray())
                {
                    var core = JsonSerializer.Deserialize<CompoundBlueprint>(coreElement.GetRawText(), options);
                    if (core != null) _systemBlueprintTemplate.Compounds.Add(core);
                }
            }

            if (!_systemBlueprintTemplate.Compounds.Any())
                _systemBlueprintTemplate.Compounds.Add(new CompoundBlueprint { Name = "Default" });

            _showAiModal = false;
            _estimatedCommissionTime = "Evaluating AI Commission Estimate...";
            StateHasChanged();

            // Fetch AI estimate
            _estimatedCommissionTime = await AiService.GetCommissionEstimateAsync(json);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error parsing AI blueprint: {ex.Message}");
        }
    }
}
