<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=element-width, initial-scale=1.0"/>
    <base href="/"/>
    <ResourcePreloader/>
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]"/>
    <link rel="stylesheet" href="@Assets["app.css"]"/>
    <link rel="stylesheet" href="@Assets["Canvas.styles.css"]"/>
    <ImportMap/>
    <link rel="icon" type="image/png" href="favicon.png"/>
    <HeadOutlet @rendermode="InteractiveServer"/>
</head>

<body>
<Routes @rendermode="InteractiveServer"/>
<script>
    window.downloadFile = function (fileCustomerName, content) {
        // Create a hidden "blob" of data (your JSON)
        const blob = new Blob([content], { type: "application/json" });
        const url = URL.createObjectURL(blob);
        
        // Create an invisible HTML link, click it, and delete it
        const a = document.createElement("a");
        a.href = url;
        a.download = fileCustomerName;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        
        // Clean up the memory
        URL.revokeObjectURL(url);
    };

    window.openInNewTab = function (url) {
        window.open(url, '_blank');
    };

    window.renderMermaid = function () {
        if (window.mermaid) {
            mermaid.contentLoaded();
            mermaid.init(undefined, ".mermaid");
        }
    };

    window.autoResizeTextarea = function (element) {
        if (element) {
            element.style.height = "auto";
            element.style.height = (element.scrollHeight) + "px";
        }
    };
</script>
<script type="module">
    import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.esm.min.mjs';
    mermaid.initialize({ startOnLoad: true, theme: 'forest' });
    window.mermaid = mermaid;
</script>
<script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>