<nav class="fusion-header">
    <a class="navbar-brand fw-bold d-flex align-items-center gap-2" style="font-size: 0.9rem; color: var(--fusion-accent); text-decoration: none;" href="#">
        <i class="bi bi-fire"></i>
        <span style="color: var(--fusion-text); letter-spacing: 0.05em;">FUSION LAB</span>
    </a>
    <div class="d-flex gap-2 ms-auto">
        <button class="btn-fusion btn-fusion-outline" @onclick="OnExportClicked">
            <i class="bi bi-download me-1"></i> EXPORT
        </button>
        <label class="btn-fusion btn-fusion-outline m-0 pointer">
            <i class="bi bi-folder2-open me-1"></i> OPEN
            <InputFile OnChange="HandleFileSelected" class="d-none" />
        </label>
    </div>
</nav>

@code {
    [Parameter]
    public EventCallback OnExportClicked { get; set; }

    [Parameter]
    public EventCallback<InputFileChangeEventArgs> OnFileSelected { get; set; }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        await OnFileSelected.InvokeAsync(e);
    }
}