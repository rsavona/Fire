@using FusionLab.Services
@using Fusion.Common.Blueprints
@inject ElementDiscoveryService DiscoveryService
@inject CompoundService CompoundService
@inject IJSRuntime JSRuntime

<div class="fusion-sidebar d-flex flex-column">
    
    <!-- ELEMENTS SECTION -->
    <div class="sidebar-section-header d-flex flex-column align-items-start" 
         style="background: rgba(255,255,255,0.05); border-left: 4px solid var(--fusion-accent) !important; padding: 10px; margin-bottom: 5px; margin-top: 10px; border-radius: 0 4px 4px 0;"
         @onclick="() => _elementsCollapsed = !_elementsCollapsed">
        <div class="d-flex justify-content-between w-100 align-items-center">
            <span class="fw-bold text-white" style="letter-spacing: 1px;">ELEMENTS</span>
            <i class="bi @(_elementsCollapsed ? "bi-chevron-right" : "bi-chevron-down") text-muted"></i>
        </div>
        @if (!_elementsCollapsed)
        {
            <small class="text-info mt-1" style="font-size: 0.7rem;"><i class="bi bi-arrows-move me-1"></i>Drag to Canvas | <i class="bi bi-info-circle ms-1 me-1"></i>Click for Info</small>
        }
    </div>
    
    @if (!_elementsCollapsed)
    {
        <div class="nav flex-column gap-1 p-2">
            @foreach (var elementType in DiscoveryService.GetDiscoveredElements())
            {
                <div class="toolbox-item" 
                     draggable="true" 
                     @onclick="@(() => OpenDocs(elementType.Name))"
                     @ondragstart="@(() => HandleDragStart(elementType.Name))">
                    <i class="bi @GetIconForType(elementType.Name)"></i> 
                    <span>@FormatName(elementType.Name)</span>
                    <i class="bi bi-info-circle info-icon"></i>
                </div>
            }
        </div>
    }
    
    <!-- COMPOUNDS SECTION -->
    <div class="sidebar-section-header d-flex flex-column align-items-start" 
         style="background: rgba(255,255,255,0.05); border-left: 4px solid var(--fusion-primary) !important; padding: 10px; margin-bottom: 5px; margin-top: 10px; border-radius: 0 4px 4px 0;"
         @onclick="() => _compoundsCollapsed = !_compoundsCollapsed">
        <div class="d-flex justify-content-between w-100 align-items-center">
            <span class="fw-bold text-white" style="letter-spacing: 1px;">COMPOUNDS</span>
            <i class="bi @(_compoundsCollapsed ? "bi-chevron-right" : "bi-chevron-down") text-muted"></i>
        </div>
        @if (!_compoundsCollapsed)
        {
            <small class="text-info mt-1" style="font-size: 0.7rem;"><i class="bi bi-arrows-move me-1"></i>Drag to Canvas</small>
        }
    </div>

    @if (!_compoundsCollapsed)
    {
        <div class="nav flex-column gap-1 p-2">
            @foreach (var compound in CompoundService.GetDiscoveredCompounds())
            {
                <div class="toolbox-item" 
                     draggable="true" 
                     @ondragstart="@(() => HandleDragStart("Compound:" + compound.Name))">
                    <i class="bi bi-box-seam"></i> 
                    <span>@compound.Name</span>
                </div>
            }
        </div>
    }

    <!-- REACTIONS SECTION -->
    <div class="sidebar-section-header d-flex flex-column align-items-start" 
         style="background: rgba(255,255,255,0.05); border-left: 4px solid #ef4444 !important; padding: 10px; margin-bottom: 5px; margin-top: 10px; border-radius: 0 4px 4px 0;"
         @onclick="() => _reactionsCollapsed = !_reactionsCollapsed">
        <div class="d-flex justify-content-between w-100 align-items-center">
            <span class="fw-bold text-white" style="letter-spacing: 1px;">REACTIONS</span>
            <i class="bi @(_reactionsCollapsed ? "bi-chevron-right" : "bi-chevron-down") text-muted"></i>
        </div>
        @if (!_reactionsCollapsed)
        {
            <small class="text-info mt-1" style="font-size: 0.7rem;"><i class="bi bi-arrows-move me-1"></i>Drag to Canvas | <i class="bi bi-info-circle ms-1 me-1"></i>Click for Info</small>
        }
    </div>

    @if (!_reactionsCollapsed)
    {
        <div class="nav flex-column gap-1 p-2">
            @foreach (var reactionType in DiscoveryService.GetDiscoveredReactions())
            {
                <div class="toolbox-item" 
                     draggable="true" 
                     @onclick="@(() => OpenDocs(reactionType.Name))"
                     @ondragstart="@(() => HandleDragStart("Reaction"))">
                    <i class="bi bi-diagram-3"></i> 
                    <span>@reactionType.Name</span>
                    <i class="bi bi-info-circle info-icon"></i>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public EventCallback<string> OnItemDragStart { get; set; }

    private bool _elementsCollapsed = false;
    private bool _compoundsCollapsed = false;
    private bool _reactionsCollapsed = false;

    private async Task HandleDragStart(string elementType)
    {
        await OnItemDragStart.InvokeAsync(elementType);
    }

    private async Task OpenDocs(string typeName)
    {
        string docFile = GetDocFileName(typeName);
        if (!string.IsNullOrEmpty(docFile))
        {
            await JSRuntime.InvokeVoidAsync("openInNewTab", $"/documentation/{docFile}");
        }
    }

    private string GetDocFileName(string typeName) => typeName switch
    {
        string s when s.Contains("ActiveMq") => "ReadMe-ActiveMQ.md",
        string s when s.Contains("Ai") => "ReadMe-AiSuite.md",
        string s when s.Contains("Api") => "ReadMe-ApiSuite.md",
        string s when s.Contains("Database") => "ReadMe-DatabaseSuite.md",
        string s when s.Contains("Enterprise") => "ReadMe-EnterpriseSuite.md",
        string s when s.Contains("HostComm") || s.Contains("FileMessage") || s.Contains("TcpMessage") => "ReadMe-HostComm.md",
        string s when s.Contains("Mqtt") => "ReadMe-Mqtt.md",
        string s when s.Contains("Nats") => "ReadMe-NATS.md",
        string s when s.Contains("Notification") || s.Contains("Email") => "ReadMe-NotificationSuite.md",
        string s when s.Contains("Plc") => "ReadMe-PlcSuite.md",
        string s when s.Contains("Printer") => "ReadMe-PrinterSuite.md",
        string s when s.Contains("Scanner") => "ReadMe-ScannerSuite.md",
        string s when s.Contains("Diagnostic") || s.Contains("BlueprintVerifier") => "ReadMe-SupportCLI.md",
        _ => ""
    };

    private string GetIconForType(string typeName) => typeName switch
    {
        string s when s.Contains("Plc") && s.Contains("Virtual") => "bi-cpu text-white-50",
        string s when s.Contains("Plc") => "bi-hdd-rack text-danger",
        string s when s.Contains("Printer") && s.Contains("Virtual") => "bi-file-earmark-code text-white-50",
        string s when s.Contains("Printer") => "bi-printer text-warning",
        string s when s.Contains("ActiveMq") => "bi-envelope-paper text-info",
        string s when s.Contains("Database") => "bi-database-fill text-primary",
        string s when s.Contains("Api") || s.Contains("Controller") => "bi-cloud-arrow-down text-success",
        _ => "bi-box text-muted"
    };

    private string FormatName(string name)
    {
        return name.Replace("Element", "").Replace("Server", "").Replace("Client", "").Replace("Manager", "");
    }
}
