{
  "AppSettings": {
    "Fusion": {
      "Name": "MedlinePNA4",
      "ColorConsole": true,
      "DiagnosticPort": 9999,
      "ReactionList": [
        {
          "Name": "PrintAndApplyFrc",
          "Type": "PrintAndApplyFrc",
          "Enable": true,
          "Bonds": [
            {
              "Mode": 1,
              "Name": "Bond1-InductRequestToResponse",
              "Source": "TPAN2.DReqM.PNALINE-2",
              "Handler": "HandlePrintersToUseAsync",
              "Destination": "TPAN2.DRespM.PNALINE-2"
            },
            {
              "Mode": 1,
              "Name": "Bond2-InductRequestToQueue",
              "Source": "TPAN2.DReqM.PNALINE-2",
              "Handler": "HandleLabelRequestToMqAsync",
              "Destination": "TBROKER.LabelRequestFrcMessage.AC.PNA.LABELREQUEST"
            },
            {
              "Mode": 1,
              "Name": "Bond3-VerifyRequestToQueue",
              "Source": "TPAN2.DReqM.PNA2_Verify",
              "Handler": "HandleLabelVerificationToMqAsync",
              "Destination": "TBROKER.LabelVerifyFrcMessage.AC.PNA.LABELVERIFY"
            },
            {
              "Mode": 1,
              "Name": "Bond4-QueueToMemory",
              "Source": "TBROKER.LabelDataFrcMessage.AC.PNA.LABELDATA",
              "Handler": "HandleLabelToStorageAsync",
              "Destination": "PrintAndApplyFrc.LabelToPrint.Storage"
            },
            {
              "Mode": 1,
              "Name": "Bond5-ShiptopPrinter1",
              "Source": "TPAN2.DReqM.PNA2_151",
              "Destination": "PNA2_151.LabelToPrint.None",
              "Handler": "HandleBarcodeToPrinterAsync"
            },
            {
              "Mode": 1,
              "Name": "Bond6-ShiptopPrinter2",
              "Source": "TPAN2.DReqM.PNA2_152",
              "Destination": "PNA2_152.LabelToPrint.None",
              "Handler": "HandleBarcodeToPrinterAsync"
            },
            {
              "Mode": 1,
              "Name": "Bond7-ContentsdropPrinter1",
              "Source": "TPAN2.DReqM.I001",
              "Handler": "HandleContentToPrinterAsync",
              "Destination": "I001.LabelToPrint.None"
            },
            {
              "Mode": 1,
              "Name": "Bond8-ContentsdropPrinter2",
              "Source": "TPAN2.DReqM.I002",
              "Handler": "HandleContentToPrinterAsync",
              "Destination": "I002.LabelToPrint.None"
            }
          ]
        }
      ],
      "ElementList": [
        {
          "Name": "TPAN2",
          "Manager": "PlcElementManager",
          "Enable": true,
          "Properties": {
            "ElementPort": "6999",
            "ElementTimeout": "100000"
          }
        },
        {
          "Name": "TBROKER",
          "Manager": "ActiveMQManager",
          "Enable": true,
          "Properties": {
            "ConnectionString": "tcp://127.0.0.1:61616?KeepAlive=true",
            "DoubleQueue": false
          }
        },
        {
          "Name": "PNA2_151",
          "Manager": "PrintClientManager",
          "Enable": true,
          "Properties": {
            "IPAddress": "127.0.0.1",
            "Port": 9100,
            "PersistentConnection": true,
            "Brand": "Zebra",
            "DestinationType": "Ship",
            "PrintType": "SHIPTOP",
            "Induct": "PNALINE-2",
            "ElementTimeout": 2000,
            "PollRateMs": 1000,
            "PrintTimeoutMs": 5000,
            "PrintError": false,
            "ErrorLabel": "ERROR",
            "PreferredGroup": 1
          }
        },
        {
          "Name": "I001",
          "Manager": "PrintClientManager",
          "Enable": true,
          "Properties": {
            "IPAddress": "127.0.0.1",
            "Port": 9102,
            "PersistentConnection": true,
            "Brand": "Zebra",
            "DestinationType": "Ship",
            "PrintType": "CONTENTSDROP",
            "Induct": "PNALINE-2",
            "ElementTimeout": 2000,
            "PollRateMs": 1000,
            "PrintTimeoutMs": 5000,
            "PrintError": false,
            "ErrorLabel": "ERROR",
            "PreferredGroup": 1
          }
        },
        {
          "Name": "PNA2_152",
          "Manager": "PrintClientManager",
          "Enable": true,
          "Properties": {
            "IPAddress": "127.0.0.1",
            "Port": 9101,
            "PersistentConnection": true,
            "Brand": "Zebra",
            "DestinationType": "Ship",
            "PrintType": "SHIPTOP",
            "Induct": "PNALINE-2",
            "ElementTimeout": 2000,
            "PollRateMs": 1000,
            "PrintTimeoutMs": 5000,
            "PrintError": false,
            "ErrorLabel": "ERROR",
            "PreferredGroup": 2
          }
        },
        {
          "Name": "I002",
          "Manager": "PrintClientManager",
          "Enable": true,
          "Properties": {
            "IPAddress": "127.0.0.1",
            "Port": 9103,
            "PersistentConnection": true,
            "Brand": "Zebra",
            "DestinationType": "Ship",
            "PrintType": "CONTENTSDROP",
            "Induct": "PNALINE-2",
            "ElementTimeout": 2000,
            "PollRateMs": 1000,
            "PrintTimeoutMs": 5000,
            "PrintError": false,
            "ErrorLabel": "ERROR",
            "PreferredGroup": 2
          }
        },
        {
          "Name": "DIAG_SERVER",
          "Manager": "DiagnosticElementManager",
          "Enable": true,
          "Properties": {
            "Port": 9999
          }
        }
      ]
    }
  }
}
