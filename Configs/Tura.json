{
  "AppSettings": {
    "Fusion": {
      "Name": "TuraSort",
      "ColorConsole": true,
      "DiagnosticPort": 9999,
      "ReactionList": [
        {
          "Name": "StandardSort",
          "Type": "StandardSort",
          "Enable": true,
          "Bonds": [
            {
              "Mode": 1,
              "Name": "Bond1-InductRequestToResponse",
              "Source": "TPNA2.DReqM.PNALINE-2",
              "Handler": "HandleInductionRoundRobinSort",
              "Destination": "TPNA2.DRespM.PNALINE-2"
            }
          ]
        }
      ],
      "ElementList": [
        {
          "Name": "PLC1",
          "Manager": "PlcElementManager",
          "Enable": true,
          "Properties": {
            "ElementPort": "6999",
            "ElementTimeout": "15000"
          }
        },
        {
          "Name": "SQLServer",
          "Manager": "DatabaseElementManager",
          "Enable": true,
          "Properties": {
            "ConnectionString": "15000"
          }
        }
      ]
    }
  }
}
 


